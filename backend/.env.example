# ──────────────────────────────────────────────
# AI Service Desk — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Required: Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default SQLite DB path (PostgreSQL example below)
# DATABASE_URL=postgresql://user:password@localhost:5432/servicedesk
DATABASE_URL=sqlite:///./servicedesk.db

# Optional: Debug mode (enables SQL logging)
DEBUG=false

# Optional: Comma-separated allowed CORS origins
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
